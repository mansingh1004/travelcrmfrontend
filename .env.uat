# UAT API origin — baked into the bundle at `npm run build` time.
# Vite INLINES this; changing it later means a REBUILD, not a config edit.
#
# Matches travelcrmbackend/deploy/nginx-travelcrm-uat.conf:
#   api-test.mytripsafar.com  → UAT Spring Boot API (this URL)
#   test.mytripsafar.com      → this React build, served by the UAT nginx container
#
# NOTE: Vite loads `.env.<mode>` only when built with `--mode <name>`, i.e.
# `npm run build -- --mode uat`. The UAT workflow does NOT rely on that — it
# passes VITE_API_URL as a Docker build-arg, which the Dockerfile promotes to an
# env var and which wins over any .env file. This file exists so a local
# `npm run build -- --mode uat` reproduces the CI bundle.
VITE_API_URL=https://api-test.mytripsafar.com/api
