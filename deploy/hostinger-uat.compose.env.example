# ===================================================================
# TravelCRM frontend UAT - Docker Compose environment
# -------------------------------------------------------------------
# Copy to /opt/travelcrm-frontend-uat/.env on the VPS and chmod 600.
# CI overrides TRAVELCRM_FRONTEND_IMAGE with the exact git SHA tag.
# ===================================================================

TRAVELCRM_FRONTEND_IMAGE=your-dockerhub-username/travelcrm-frontend:uat-latest

# nginx proxies test.mytripsafar.com to http://127.0.0.1:5174.
# Production owns 5173 — do not reuse it.
HOST_BIND_PORT=5174

PRUNE_OLD_IMAGES=true
