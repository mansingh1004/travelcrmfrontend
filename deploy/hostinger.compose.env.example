# ===================================================================
# TravelCRM frontend - Hostinger Docker Compose environment
# -------------------------------------------------------------------
# Copy to /opt/travelcrm-frontend/.env on the VPS and chmod 600.
# CI overrides TRAVELCRM_FRONTEND_IMAGE with the exact git SHA tag.
# ===================================================================

TRAVELCRM_FRONTEND_IMAGE=your-dockerhub-username/travelcrm-frontend:latest

# nginx should proxy mytripsafar.com/www to http://127.0.0.1:5173.
HOST_BIND_PORT=5173

PRUNE_OLD_IMAGES=true
